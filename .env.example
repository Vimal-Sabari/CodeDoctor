# Copy to .env and fill in values as needed. Never commit .env.

# Optional: GitHub Personal Access Token for higher API rate limits during log collection
GITHUB_TOKEN=

# Optional: Hugging Face token for gated/rate-limited model downloads
HF_TOKEN=

# Local llama.cpp server endpoint
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
